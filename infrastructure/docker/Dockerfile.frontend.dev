# GeoSentinel frontend — Vite dev server (optional dev compose)
FROM node:20-alpine

RUN addgroup -g 1000 geosentinel && adduser -u 1000 -G geosentinel -D geosentinel

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend .

RUN chown -R geosentinel:geosentinel /app
USER geosentinel

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
