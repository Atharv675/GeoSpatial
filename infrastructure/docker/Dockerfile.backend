# GeoSentinel backend — non-root, pinned deps
FROM python:3.12-slim-bookworm

RUN groupadd --gid 1000 geosentinel \
    && useradd --uid 1000 --gid geosentinel --shell /bin/bash --create-home geosentinel

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 gdal-bin libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements/dev.txt requirements/raster.txt /app/requirements/
RUN pip install --no-cache-dir -r /app/requirements/dev.txt

COPY backend /app/backend
COPY data/registry /app/data/registry
COPY scripts /app/scripts

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

RUN chown -R geosentinel:geosentinel /app
USER geosentinel

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health')" || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
