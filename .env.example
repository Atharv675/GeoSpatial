# GeoSentinel — copy to .env and adjust (never commit .env)

# Application
APP_ENV=development
APP_NAME=GeoSentinel
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL + PostGIS)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=geosentinel
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=geosentinel_dev

# Data paths (container paths)
DATA_ROOT=/app/data
REGISTRY_PATH=/app/data/registry

# Pipeline scope (strict limits)
MAX_AOIS=3
TIME_RANGE_DAYS=30
TILE_SIZE=512
UPDATE_FREQUENCY=weekly

# Raster preprocessing (Phase 3)
TARGET_CRS_EPSG=3857
CLOUD_COVER_THRESHOLD=20
RASTER_CHUNK_SIZE=512
MAX_RASTER_PIXELS=16777216

# Anomaly scoring (Phase 4)
ANOMALY_NDVI_THRESHOLD=0.15
ANOMALY_NDWI_THRESHOLD=0.12
ANOMALY_NBR_THRESHOLD=0.18
ANOMALY_SAR_THRESHOLD=0.20
ANOMALY_COMPOSITE_THRESHOLD=0.45

# OSINT (Phase 5)
OSINT_LIVE_FETCH_ENABLED=false
OSINT_CORRELATION_WINDOW_DAYS=7
OSINT_MAX_EVENTS_PER_SOURCE=100
OSINT_MAX_MATCHES_PER_AOI=25
# FIRMS_MAP_KEY=
# ACLED_EMAIL=
# ACLED_PASSWORD=

# Explainability (Phase 6)
# EXPLAINABILITY_PNG_WIDTH=512

# E2E bootstrap (Phase 8 — docker compose bootstrap service)
# FORCE_E2E_BOOTSTRAP=1

# ═══════════════════════════════════════════════════════════════════════════════
# GOD'S EYE VIEW — Data Sources & Telemetry Ingestion (see DATA_SOURCES.md)
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. 3D Globe & Basemap Providers ──────────────────────────────────────────
# Google Maps 3D Photorealistic Tiles & Geocoding (Client-Exposed)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# Dedicated server-side Google API key for Places & Street View fallbacks
GOOGLE_MAPS_SERVER_API_KEY=
GEV_RATELIMIT_GOOGLE_PER_MIN=60

# Cesium ion Token (Google 3D Tiles, Bing Imagery, Cesium World Terrain)
CESIUM_ION_TOKEN=
VITE_CESIUM_ION_TOKEN=

# ── 2. Aerial & Orbital Telemetry Feeds ───────────────────────────────────────
# OpenSky Network (Primary Global Live Aircraft Snapshot)
# Non-commercial research/education license
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# adsb.lol Fallback & GNSS Integrity (Keyless ODbL 1.0)
# Evaluates GPS-loss flags, NACp < 8, NIC < 7 jamming anomalies

# Local ADS-B Decoders (RTL-SDR USB dongle, dump1090, readsb)
# Comma-separated band=url entries (1090 or 978 UAT)
# LOCAL_RECEIVER_FEEDS=1090=http://localhost:8080/data/aircraft.json,978=http://localhost:8978/data/aircraft.json

# The Space Devs / Launch Library 2 (Spacecraft & Rocket Launches)
# Optional token raises rate limit beyond 15 calls/hour
LL2_API_TOKEN=

# ── 3. Maritime AIS Telemetry ────────────────────────────────────────────────
# AISStream.io (Global Real-Time AIS Vessel Broadcasts)
AISSTREAM_API_KEY=
VITE_AIS_LIVE_MAX_ROWS=12000
VITE_AIS_LIVE_LABEL_MAX_ROWS=900
AISSTREAM_SILENCE_TIMEOUT_MS=120000

# ── 4. Thermal Wildfires & Hazard Monitoring ──────────────────────────────────
# NASA FIRMS (Fire Information for Resource Management System)
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ── 5. Street Level & Traffic Telemetry ───────────────────────────────────────
# Mapillary Graph API Client Token (Street Level vector tiles & photo cones)
MAPILLARY_CLIENT_TOKEN=
VITE_MAPILLARY_CLIENT_TOKEN=

# TomTom Live Traffic Flow & Incidents (BYOK Freemium: 200K requests/month)
TOMTOM_API_KEY=
TOMTOM_DAILY_TILE_BUDGET=6000

# ── 6. Public CCTV & Traffic Camera Networks ──────────────────────────────────
CCTV_SOURCES_FILE=config/cctv_sources.austin.json
CCTV_AUSTIN_MAX_SOURCES=250
CCTV_CALTRANS_DISTRICTS=4,7,11,3
CCTV_CALTRANS_MAX_SOURCES=300
CCTV_TFL_ENABLED=1
CCTV_TFL_MAX_SOURCES=250
TFL_APP_KEY=
CCTV_ONTARIO_ENABLED=1
CCTV_ONTARIO_MAX_SOURCES=1000
CCTV_FINTRAFFIC_ENABLED=1
CCTV_FINTRAFFIC_MAX_SOURCES=300
CCTV_DRIVEBC_ENABLED=1
CCTV_DRIVEBC_MAX_SOURCES=250
CCTV_TXDOT_ENABLED=1
CCTV_TXDOT_DISTRICTS=AUS,SAT
CCTV_TXDOT_MAX_SOURCES=500
CCTV_TALLINN_ENABLED=1
CCTV_TALLINN_MAX_SOURCES=255
CCTV_TARKTEE_ENABLED=1
CCTV_TARKTEE_MAX_SOURCES=179
CCTV_WARENDORF_ENABLED=1
CCTV_NSW_ENABLED=1
CCTV_NSW_MAX_SOURCES=250
CCTV_CALGARY_ENABLED=1
CCTV_CALGARY_MAX_SOURCES=220
CCTV_CATALONIA_ENABLED=1
CCTV_CATALONIA_MAX_SOURCES=150
CCTV_KINGCOUNTY_ENABLED=1
CCTV_KINGCOUNTY_MAX_SOURCES=125
CCTV_WSDOT_ENABLED=1
CCTV_WSDOT_MAX_SOURCES=250
CCTV_VEGVESEN_ENABLED=1
CCTV_VEGVESEN_MAX_SOURCES=900
CCTV_VEGVESEN_VIDEO=1
CCTV_TORONTO_ENABLED=1
CCTV_TORONTO_MAX_SOURCES=336
CCTV_MAX_SOURCES=4000
CCTV_PREFER_AUSTIN=1
# Off by default (requires operator data-sharing agreement)
CCTV_NYC_ENABLED=0
CCTV_LITHUANIA_ENABLED=0

# ── 7. Overpass & Public Geodata Servers ──────────────────────────────────────
# Comma-separated self-hosted or dedicated Overpass API endpoints
OVERPASS_UPSTREAMS=

# ── 8. Voice Assistant & Realtime Audio (Optional) ────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano
GEV_RATELIMIT_OPENAI_PER_MIN=30
